{
  "manifest_version": 3,
  "name": "YapBlocker",
  "version": "1.0.0",
  "description": "Suppresses high pitches on YouTube. Lowers the tab to 25% volume while a high-pitched voice is speaking. Audio is processed locally.",
  "permissions": ["activeTab", "offscreen", "storage", "tabCapture"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "YapBlocker",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "web_accessible_resources": []
}
